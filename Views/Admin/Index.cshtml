@model CURSO_INTERCULTURALIDAD.Models.PanelAdminCodigosViewModel
@{
    ViewData["Title"] = "Panel Admin";
    var cursoActual = Model.Cursos.FirstOrDefault(item => item.IdActividad == Model.CursoSeleccionadoId);
    var cursoTieneCobro = string.Equals(cursoActual?.SeCobra, "Si", StringComparison.OrdinalIgnoreCase);
    var requiereCodigoInsnsb = cursoTieneCobro
        && (cursoActual?.CostoPersonalInsnsb ?? 0m) > 0m
        && decimal.Round(cursoActual?.CostoBase ?? 0m, 2, MidpointRounding.AwayFromZero) !=
           decimal.Round(cursoActual?.CostoPersonalInsnsb ?? cursoActual?.CostoBase ?? 0m, 2, MidpointRounding.AwayFromZero);
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-shell">
    <div class="admin-toolbar">
        <div>
            <span class="admin-eyebrow">INSNSB - Administracion</span>
            <h1>Panel de cursos y códigos únicos</h1>
            <p>Administra la visibilidad del formulario publico, corrige la ficha del curso antes de publicarla y revisa pagos o códigos únicos desde un solo lugar.</p>
        </div>
        <div class="admin-toolbar-actions">
            <a class="btn btn-outline-primary" asp-action="ReporteInscritos" asp-route-cursoId="@Model.CursoSeleccionadoId">Reporte inscritos</a>
            @if (cursoTieneCobro)
            {
                <a class="btn btn-outline-primary" asp-action="ReportePagantes" asp-route-cursoId="@Model.CursoSeleccionadoId">Reporte pagantes</a>
            }
            <form asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">Cerrar sesion</button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
    {
        <div class="alert alert-success">@Model.MensajeExito</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="alert alert-danger">@Model.MensajeError</div>
    }

    <div class="admin-grid">
        <section class="admin-card">
            <h2>Curso</h2>
            <form id="adminCourseSelectorForm" asp-action="Index" method="get" class="admin-form-stack">
                <div>
                    <label for="cursoId" class="form-label">Curso administrado</label>
                    <div class="admin-course-filter" role="group" aria-label="Filtro por tipo de curso">
                        <button type="button" class="admin-filter-chip active" data-course-charge-filter="todos">Todos</button>
                        <button type="button" class="admin-filter-chip" data-course-charge-filter="Si">Pagados</button>
                        <button type="button" class="admin-filter-chip" data-course-charge-filter="No">Gratuitos</button>
                    </div>
                    <div class="admin-search-select">
                        <input id="cursoSearch" class="form-control" type="search" autocomplete="off" placeholder="Escriba el nombre o ID del curso..." value="@(cursoActual?.NombreActividad ?? string.Empty)" />
                        <div id="cursoSearchResults" class="admin-search-results" hidden></div>
                    </div>
                    <select id="cursoId" name="cursoId" class="form-select admin-native-select-hidden" onchange="this.form.submit()">
                        @foreach (var curso in Model.Cursos)
                        {
                            var tipoCobro = string.Equals(curso.SeCobra, "Si", StringComparison.OrdinalIgnoreCase) ? "Si" : "No";
                            if (curso.IdActividad == Model.CursoSeleccionadoId)
                            {
                                <option value="@curso.IdActividad" data-charge="@tipoCobro" selected>@curso.NombreActividad</option>
                            }
                            else
                            {
                                <option value="@curso.IdActividad" data-charge="@tipoCobro">@curso.NombreActividad</option>
                            }
                        }
                    </select>
                    <small class="text-muted">Aqui aparecen los cursos visibles al alumno y tambien los historicos con pagos o movimientos previos.</small>
                </div>
            </form>

            @if (Model.CursoSeleccionadoId.HasValue)
            {
                <div class="stats-pills">
                    @if (requiereCodigoInsnsb)
                    {
                        <span>Total codigos: <strong>@Model.TotalCodigos</strong></span>
                        <span>Disponibles: <strong>@Model.CodigosDisponibles</strong></span>
                        <span>Usados: <strong>@Model.CodigosUsados</strong></span>
                    }
                    <span>Visible al alumno: <strong>@(cursoActual?.VisibleEnFormulario ?? "Si")</strong></span>
                    <span>Historico admin: <strong>@(cursoActual?.FuePagadoHistorico ?? "No")</strong></span>
                    <span>Se cobra: <strong>@(cursoActual?.SeCobra ?? "No")</strong></span>
                </div>

                <div class="admin-card-actions">
                    <a class="btn btn-outline-primary" asp-action="EditarCurso" asp-route-cursoId="@Model.CursoSeleccionadoId">
                        Editar ficha publica del curso
                    </a>
                </div>
            }
        </section>

        @if (requiereCodigoInsnsb)
        {
        <section class="admin-card">
            <h2>Asignar código a documento</h2>
            <form asp-action="GenerarCodigos" method="post" class="admin-form-stack">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Formulario.CursoId" value="@Model.CursoSeleccionadoId" />

                <div>
                    <label asp-for="Formulario.DniAsignado" class="form-label">DNI/CE/Pasaporte del personal</label>
                    <input asp-for="Formulario.DniAsignado" class="form-control" maxlength="20" inputmode="text" autocomplete="off" placeholder="Ingrese el documento que recibira el codigo" />
                    <span asp-validation-for="Formulario.DniAsignado" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Formulario.GeneradoPor" class="form-label">Generado por</label>
                    <input asp-for="Formulario.GeneradoPor" class="form-control" placeholder="Responsable de la asignacion" />
                    <span asp-validation-for="Formulario.GeneradoPor" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Formulario.Observacion" class="form-label">Observación</label>
                    <textarea asp-for="Formulario.Observacion" class="form-control" rows="3" placeholder="Ej. Código reservado para la segunda convocatoria interna"></textarea>
                    <span asp-validation-for="Formulario.Observacion" class="text-danger"></span>
                </div>
                @if (Model.CursoSeleccionadoId.HasValue)
                {
                    <button type="submit" class="btn btn-brand">Generar codigo</button>
                }
                else
                {
                    <button type="submit" class="btn btn-brand" disabled>Generar codigo</button>
                }
            </form>
        </section>
        }
    </div>

    @if (requiereCodigoInsnsb && Model.CodigosGenerados.Count > 0)
    {
        <section class="admin-card">
            <h2>Codigos recien generados</h2>
            <textarea class="form-control code-output" rows="8" readonly>@string.Join(Environment.NewLine, Model.CodigosGenerados)</textarea>
        </section>
    }

    @if (requiereCodigoInsnsb)
    {
    <section class="admin-card">
        <h2>Últimos códigos del curso</h2>

        @if (Model.Codigos.Count == 0)
        {
            <p class="text-muted mb-0">Aún no hay códigos registrados para este curso.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Documento asignado</th>
                            <th>Estado</th>
                            <th>Generado</th>
                            <th>Usado por</th>
                            <th>Observación</th>
                            <th class="text-end">Accion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var codigo in Model.Codigos)
                        {
                            <tr>
                                <td><code>@codigo.Codigo</code></td>
                                <td>@(string.IsNullOrWhiteSpace(codigo.DniAsignado) ? "-" : codigo.DniAsignado)</td>
                                <td>
                                    <span class="status-badge @(codigo.Estado == "Usado" ? "used" : "available")">@codigo.Estado</span>
                                </td>
                                <td>@codigo.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(codigo.UsadoPorDocumento) && string.IsNullOrWhiteSpace(codigo.UsadoPorCorreo))
                                    {
                                        <span class="text-muted">Disponible</span>
                                    }
                                    else
                                    {
                                        <div>@codigo.UsadoPorDocumento</div>
                                        <div class="small text-muted">@codigo.UsadoPorCorreo</div>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(codigo.Observacion) ? "-" : codigo.Observacion)</td>
                                <td class="text-end">
                                    <form asp-action="EliminarCodigo" method="post" class="d-inline js-confirm-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cursoId" value="@Model.CursoSeleccionadoId" />
                                        <input type="hidden" name="codigoId" value="@codigo.IdCodigo" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                data-confirm-title="Eliminar código INSNSB"
                                                data-confirm-message="Se eliminara el código @codigo.Codigo. Esta accion no se puede deshacer.">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    }

    <section class="admin-card">
        <div class="admin-section-header">
            <div>
                <h2>@(cursoTieneCobro ? "Seguimiento de pagos" : "Seguimiento de inscripciones")</h2>
                <p class="admin-section-copy">
                    @(cursoTieneCobro
                        ? "Consulta por curso el estado de pago de cada alumno y abre el detalle de cuotas solo cuando lo necesites."
                        : "Consulta por curso los alumnos inscritos y sus datos principales de contacto.")
                </p>
            </div>

            {
                <div class="admin-toolbar-actions">
                    <form asp-action="SincronizarPagosIzipay" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cursoId" value="@Model.CursoSeleccionadoId" />
                        <button type="submit" class="btn btn-outline-secondary">
                            Actualizar pagos IziPay
                        </button>
                    </form>
                    <a class="btn btn-outline-primary" asp-action="ReportePagantes" asp-route-cursoId="@Model.CursoSeleccionadoId">Abrir reporte de pagantes</a>
                </div>
            }
        </div>

        @if (!Model.CursoSeleccionadoId.HasValue)
        {
            <p class="text-muted mb-0">Seleccione un curso para revisar sus inscripciones.</p>
        }
        else if (Model.SeguimientoPagos.Alumnos.Count == 0)
        {
            <p class="text-muted mb-0">Este curso aun no registra inscripciones.</p>
        }
        else
        {
            <div class="admin-table-tools">
                <div class="admin-table-search">
                    <label for="paymentTableSearch" class="form-label">Buscar en seguimiento</label>
                    <input id="paymentTableSearch" type="search" class="form-control" placeholder="Busca por alumno, correo, documento, estado o celular" autocomplete="off" />
                </div>
                <div class="admin-table-meta">
                    <span id="paymentTableResultCount" class="text-muted">Mostrando @Model.SeguimientoPagos.Alumnos.Count registro(s)</span>
                </div>
            </div>

            <div class="stats-pills">
                <span>Inscripciones: <strong>@Model.SeguimientoPagos.TotalInscripciones</strong></span>
                @if (cursoTieneCobro)
                {
                    <span>Con deuda: <strong>@Model.SeguimientoPagos.ConDeudaPendiente</strong></span>
                    <span>Pagados: <strong>@Model.SeguimientoPagos.CompletamentePagados</strong></span>
                    <span>Monto pagado: <strong>@(Model.SeguimientoPagos.MontoPagado == 0m ? "--" : $"S/ {Model.SeguimientoPagos.MontoPagado:N2}")</strong></span>
                    <span>Monto pendiente: <strong>@(Model.SeguimientoPagos.MontoPendiente == 0m ? "--" : $"S/ {Model.SeguimientoPagos.MontoPendiente:N2}")</strong></span>
                }
                else
                {
                    <span>Inscripcion gratuita: <strong>Si</strong></span>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle admin-payment-table" id="paymentTrackingTable">
                    <thead>
                        <tr>
                            <th><button type="button" class="admin-sort-button js-sort-payments" data-sort-key="alumno">Alumno</button></th>
                            <th><button type="button" class="admin-sort-button js-sort-payments" data-sort-key="documento">Documento</button></th>
                            <th><button type="button" class="admin-sort-button js-sort-payments" data-sort-key="registro">Registro</button></th>
                            <th><button type="button" class="admin-sort-button js-sort-payments" data-sort-key="estado">@(cursoTieneCobro ? "Estado" : "Estado de inscripcion")</button></th>
                            @if (cursoTieneCobro)
                            {
                                <th><button type="button" class="admin-sort-button js-sort-payments" data-sort-key="total">Total</button></th>
                                <th><button type="button" class="admin-sort-button js-sort-payments" data-sort-key="pagado">Pagado</button></th>
                                <th><button type="button" class="admin-sort-button js-sort-payments" data-sort-key="pendiente">Pendiente</button></th>
                                <th><button type="button" class="admin-sort-button js-sort-payments" data-sort-key="cuotas">Cuotas</button></th>
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="paymentTrackingTableBody">
                        @foreach (var alumno in Model.SeguimientoPagos.Alumnos)
                        {
                            var detalleId = $"detalle-{alumno.IdInscripcion}";
                            var textoBusqueda = string.Join(' ', new[]
                            {
                                alumno.Nombres,
                                alumno.Apellidos,
                                alumno.Correo,
                                alumno.NumeroDocumento,
                                alumno.EstadoPagoGeneral,
                                alumno.Celular,
                                alumno.NombreCurso
                            }.Where(value => !string.IsNullOrWhiteSpace(value))).ToUpperInvariant();
                            <tr class="payment-summary-row"
                                data-search="@textoBusqueda"
                                data-sort-alumno="@($"{alumno.Nombres} {alumno.Apellidos}".Trim().ToUpperInvariant())"
                                data-sort-documento="@((alumno.NumeroDocumento ?? string.Empty).ToUpperInvariant())"
                                data-sort-registro="@alumno.FechaRegistro.ToString("yyyyMMddHHmmss")"
                                data-sort-estado="@((alumno.EstadoPagoGeneral ?? string.Empty).ToUpperInvariant())"
                                data-sort-total="@alumno.CostoFinal.ToString("0000000000000.00", System.Globalization.CultureInfo.InvariantCulture)"
                                data-sort-pagado="@alumno.MontoPagado.ToString("0000000000000.00", System.Globalization.CultureInfo.InvariantCulture)"
                                data-sort-pendiente="@alumno.MontoPendiente.ToString("0000000000000.00", System.Globalization.CultureInfo.InvariantCulture)"
                                data-sort-cuotas="@($"{alumno.CuotasPagadas:D4}-{alumno.NumeroCuotas:D4}")">
                                <td>
                                    <div class="table-primary-text">@alumno.Nombres @alumno.Apellidos</div>
                                    <div class="small text-muted">@alumno.Correo</div>
                                </td>
                                <td>@alumno.NumeroDocumento</td>
                                <td>@alumno.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="status-badge @(cursoTieneCobro && !string.Equals(alumno.EstadoPagoGeneral, "PAGADO", StringComparison.OrdinalIgnoreCase) ? "used" : "available")">
                                        @(cursoTieneCobro ? alumno.EstadoPagoGeneral : "INSCRITO")
                                    </span>
                                </td>
                                @if (cursoTieneCobro)
                                {
                                    <td>@(alumno.CostoFinal == 0m ? "--" : $"S/ {alumno.CostoFinal:N2}")</td>
                                    <td>@(alumno.MontoPagado == 0m ? "--" : $"S/ {alumno.MontoPagado:N2}")</td>
                                    <td>@(alumno.MontoPendiente == 0m ? "--" : $"S/ {alumno.MontoPendiente:N2}")</td>
                                    <td>@alumno.CuotasPagadas/@alumno.NumeroCuotas</td>
                                }
                                <td class="text-end">
                                    <div class="admin-row-actions">
                                        @if (cursoTieneCobro)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary js-toggle-detail" data-target="@detalleId">
                                                Mas detalle
                                            </button>
                                        }
                                        <form asp-action="EliminarInscripcion" method="post" class="d-inline js-confirm-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cursoId" value="@Model.CursoSeleccionadoId" />
                                            <input type="hidden" name="idInscripcion" value="@alumno.IdInscripcion" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-confirm-title="Eliminar inscrito"
                                                    data-confirm-message="Se eliminara la inscripcion de @alumno.Nombres @alumno.Apellidos y sus datos de seguimiento. Si uso codigo INSNSB, el codigo quedara disponible nuevamente.">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            @if (cursoTieneCobro)
                            {
                            <tr id="@detalleId" class="payment-detail-row hidden-detail-row">
                                <td colspan="9">
                                    <div class="payment-detail-box">
                                        <div class="payment-detail-meta">
                                            <span>Celular: <strong>@(string.IsNullOrWhiteSpace(alumno.Celular) ? "-" : alumno.Celular)</strong></span>
                                            <span>Cuotas pendientes: <strong>@alumno.CuotasPendientes</strong></span>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Cuota</th>
                                                        <th>Monto</th>
                                                        <th>Fecha limite</th>
                                                        <th>Estado</th>
                                                        <th>Fecha pago</th>
                                                        <th>Accion actual</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var cuota in alumno.Cuotas.OrderBy(item => item.NumeroCuota))
                                                    {
                                                        <tr>
                                                            <td>@cuota.NumeroCuota</td>
                                                            <td>@($"S/ {cuota.Monto:N2}")</td>
                                                            <td>@cuota.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                                            <td>@cuota.Estado</td>
                                                            <td>@(cuota.FechaPagoReal.HasValue ? cuota.FechaPagoReal.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                                            <td>
                                                                @if (string.Equals(cuota.Estado, "PAGADO", StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    <div class="d-flex flex-column gap-1 align-items-start">
                                                                        <span class="small text-success">Pagado</span>
                                                                        @if (!string.IsNullOrWhiteSpace(cuota.UrlComprobantePdfIzipay))
                                                                        {
                                                                            <a class="btn btn-sm btn-outline-primary" href="@cuota.UrlComprobantePdfIzipay" target="_blank" rel="noopener noreferrer">
                                                                                Ver comprobante PDF
                                                                            </a>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(cuota.NumeroComprobanteIzipay))
                                                                        {
                                                                            <div class="small text-muted">Comprobante: @cuota.NumeroComprobanteIzipay</div>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(cuota.CodigoAutorizacionIzipay))
                                                                        {
                                                                            <div class="small text-muted">Autorizacion: @cuota.CodigoAutorizacionIzipay</div>
                                                                        }
                                                                        <div class="small text-muted">
                                                                            El comprobante sera enviado automaticamente al correo del inscrito.
                                                                            @if (string.IsNullOrWhiteSpace(cuota.UrlComprobantePdfIzipay))
                                                                            {
                                                                                <text> Si no llega, puedes revisarlo desde este panel cuando IziPay publique el PDF.</text>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else if (cuota.PuedePagarAhora)
                                                                {
                                                                    <div class="d-flex flex-column gap-1 align-items-start">
                                                                        <span class="small text-primary">Habilitada para pago</span>
                                                                        @if (cuota.IdPagoIzipay.HasValue)
                                                                        {
                                                                            <div class="small text-muted">IziPay #@cuota.IdPagoIzipay</div>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(cuota.UrlPagoIzipay))
                                                                        {
                                                                            <a class="btn btn-sm btn-outline-primary" href="@cuota.UrlPagoIzipay" target="_blank" rel="noopener noreferrer">
                                                                                Abrir link IziPay
                                                                            </a>
                                                                            <div class="small text-muted">Puedes compartir este link con el inscrito para pago presencial/asistido.</div>
                                                                        }
                                                                        else if (!string.IsNullOrWhiteSpace(cuota.TokenPagoPasarela))
                                                                        {
                                                                            <a class="btn btn-sm btn-outline-primary"
                                                                               asp-controller="InscripcionCIS"
                                                                               asp-action="IniciarPagoIzipay"
                                                                               asp-route-token="@cuota.TokenPagoPasarela"
                                                                               target="_blank"
                                                                               rel="noopener noreferrer">
                                                                                Generar link IziPay
                                                                            </a>
                                                                            <div class="small text-muted">Abrira el flujo normal y reservara la cuota para evitar duplicados.</div>
                                                                        }
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <span class="small text-muted">@cuota.BloqueoPagoMensaje</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<script>
    (() => {
        const form = document.getElementById('adminCourseSelectorForm');
        const select = document.getElementById('cursoId');
        const search = document.getElementById('cursoSearch');
        const results = document.getElementById('cursoSearchResults');
        const chips = document.querySelectorAll('[data-course-charge-filter]');
        let activeFilter = 'todos';

        if (!form || !select || !search || !results) {
            return;
        }

        const normalize = value => (value || '')
            .toString()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .trim();

        const getOptions = () => Array.from(select.options).map(option => ({
            value: option.value,
            label: option.textContent.trim(),
            charge: option.dataset.charge || 'No',
            selected: option.selected
        }));

        const closeResults = () => {
            results.hidden = true;
        };

        const renderResults = () => {
            const query = normalize(search.value);
            const matches = getOptions()
                .filter(option => activeFilter === 'todos' || option.charge === activeFilter)
                .filter(option => !query || normalize(`${option.value} ${option.label}`).includes(query))
                .slice(0, 12);

            results.innerHTML = '';

            if (matches.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'admin-search-empty';
                empty.textContent = 'No se encontraron cursos con ese filtro.';
                results.appendChild(empty);
                results.hidden = false;
                return;
            }

            matches.forEach(option => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'admin-search-option';
                button.innerHTML = `<strong>${option.label}</strong><span>ID ${option.value} · ${option.charge === 'Si' ? 'Pagado' : 'Gratuito'}</span>`;
                button.addEventListener('mousedown', event => event.preventDefault());
                button.addEventListener('click', () => {
                    select.value = option.value;
                    search.value = option.label;
                    closeResults();
                    form.submit();
                });
                results.appendChild(button);
            });

            results.hidden = false;
        };

        chips.forEach(chip => {
            chip.addEventListener('click', () => {
                activeFilter = chip.dataset.courseChargeFilter || 'todos';
                chips.forEach(item => item.classList.toggle('active', item === chip));
                renderResults();
                search.focus();
            });
        });

        search.addEventListener('input', renderResults);
        search.addEventListener('focus', renderResults);
        search.addEventListener('keydown', event => {
            if (event.key === 'Escape') {
                closeResults();
            }
        });
        document.addEventListener('click', event => {
            if (!event.target.closest('.admin-search-select') && !event.target.closest('.admin-course-filter')) {
                closeResults();
            }
        });
    })();
</script>

<div id="adminConfirmModal" class="admin-modal-backdrop" hidden>
    <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="adminConfirmTitle">
        <h2 id="adminConfirmTitle">Confirmar accion</h2>
        <p id="adminConfirmMessage">Confirma que deseas continuar.</p>
        <div class="admin-modal-actions">
            <button type="button" class="btn btn-outline-secondary" id="adminConfirmCancel">Cancelar</button>
            <button type="button" class="btn btn-danger" id="adminConfirmAccept">Si, eliminar</button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.js-toggle-detail').forEach(function (button) {
                button.addEventListener('click', function () {
                    var targetId = button.getAttribute('data-target');
                    if (!targetId) {
                        return;
                    }

                    var row = document.getElementById(targetId);
                    if (!row) {
                        return;
                    }

                    var isHidden = row.classList.contains('hidden-detail-row');
                    row.classList.toggle('hidden-detail-row', !isHidden);
                    button.textContent = isHidden ? 'Ocultar detalle' : 'Mas detalle';
                });
            });

            var table = document.getElementById('paymentTrackingTable');
            var tbody = document.getElementById('paymentTrackingTableBody');
            var searchInput = document.getElementById('paymentTableSearch');
            var resultCount = document.getElementById('paymentTableResultCount');
            var sortButtons = document.querySelectorAll('.js-sort-payments');
            var sortState = { key: 'registro', direction: 'desc' };

            if (!table || !tbody) {
                return;
            }

            function getPairs() {
                var rows = Array.from(tbody.querySelectorAll('.payment-summary-row'));
                return rows.map(function (row) {
                    return {
                        summary: row,
                        detail: row.nextElementSibling
                    };
                });
            }

            function compareValues(a, b) {
                if (a === b) {
                    return 0;
                }

                return a > b ? 1 : -1;
            }

            function applySearchAndSort() {
                var query = (searchInput ? searchInput.value : '').trim().toUpperCase();
                var pairs = getPairs();

                pairs.sort(function (left, right) {
                    var leftValue = left.summary.dataset['sort' + sortState.key.charAt(0).toUpperCase() + sortState.key.slice(1)] || '';
                    var rightValue = right.summary.dataset['sort' + sortState.key.charAt(0).toUpperCase() + sortState.key.slice(1)] || '';
                    var result = compareValues(leftValue, rightValue);
                    return sortState.direction === 'asc' ? result : result * -1;
                });

                pairs.forEach(function (pair) {
                    tbody.appendChild(pair.summary);
                    if (pair.detail) {
                        tbody.appendChild(pair.detail);
                    }
                });

                var visibleCount = 0;
                pairs.forEach(function (pair) {
                    var hayCoincidencia = !query || (pair.summary.dataset.search || '').indexOf(query) >= 0;
                    pair.summary.hidden = !hayCoincidencia;

                    if (pair.detail) {
                        pair.detail.hidden = !hayCoincidencia;
                    }

                    if (hayCoincidencia) {
                        visibleCount += 1;
                    }
                });

                if (resultCount) {
                    resultCount.textContent = 'Mostrando ' + visibleCount + ' de ' + pairs.length + ' registro(s)';
                }

                sortButtons.forEach(function (button) {
                    var isActive = button.getAttribute('data-sort-key') === sortState.key;
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('data-sort-direction', isActive ? sortState.direction : '');
                });
            }

            if (searchInput) {
                searchInput.addEventListener('input', applySearchAndSort);
            }

            sortButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    var key = button.getAttribute('data-sort-key');
                    if (!key) {
                        return;
                    }

                    if (sortState.key === key) {
                        sortState.direction = sortState.direction === 'asc' ? 'desc' : 'asc';
                    } else {
                        sortState.key = key;
                        sortState.direction = key === 'registro' ? 'desc' : 'asc';
                    }

                    applySearchAndSort();
                });
            });

            applySearchAndSort();
        });

        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('adminConfirmModal');
            var title = document.getElementById('adminConfirmTitle');
            var message = document.getElementById('adminConfirmMessage');
            var cancelButton = document.getElementById('adminConfirmCancel');
            var acceptButton = document.getElementById('adminConfirmAccept');
            var pendingForm = null;

            if (!modal || !title || !message || !cancelButton || !acceptButton) {
                return;
            }

            function closeModal() {
                modal.hidden = true;
                pendingForm = null;
            }

            document.querySelectorAll('.js-confirm-form').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    var button = event.submitter || form.querySelector('[data-confirm-message]');
                    event.preventDefault();
                    pendingForm = form;
                    title.textContent = button ? button.getAttribute('data-confirm-title') || 'Confirmar accion' : 'Confirmar accion';
                    message.textContent = button ? button.getAttribute('data-confirm-message') || 'Confirma que deseas continuar.' : 'Confirma que deseas continuar.';
                    modal.hidden = false;
                });
            });

            cancelButton.addEventListener('click', closeModal);
            modal.addEventListener('click', function (event) {
                if (event.target === modal) {
                    closeModal();
                }
            });
            acceptButton.addEventListener('click', function () {
                if (!pendingForm) {
                    closeModal();
                    return;
                }

                acceptButton.disabled = true;
                pendingForm.submit();
            });
        });
    </script>
}

